generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// CORE UNIFIED USER & ROLE SYSTEM
// ==========================================

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String
  passwordHash  String
  role          String   @default("seeker") // seeker, provider, admin, CUSTOMER, VENDOR
  avatarUrl     String?
  isVerified                 Boolean            @default(false)
  isEmailVerified            Boolean            @default(false)
  emailVerificationCode       String?
  emailVerificationExpires    DateTime?
  isPhoneVerified            Boolean            @default(false)
  phoneVerificationCode       String?
  phoneVerificationExpires    DateTime?
  rating                     Float              @default(4.8)
  totalListings              Int                @default(0)
  active                     Boolean            @default(true)
  address                    String?
  city                       String?            @default("Addis Ababa")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  // Property Platform Relations
  properties        Property[]          @relation("ProviderProperties")
  favorites         Favorite[]
  inquiriesSent     Inquiry[]           @relation("SeekerInquiries")
  notifications     Notification[]
  reports           Report[]

  // Modular Verification & Finance Relations
  identityDocuments IdentityDocument[]
  subscriptions     Subscription[]
  payments          Payment[]
  rentalRequests    RentalRequest[]     @relation("RenterRequests")
  saleRequests      SaleRequest[]       @relation("BuyerRequests")
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  // Consolidated Web & Tenant Service Relations
  vendor               Vendor?
  orders               Order[]
  serviceBookings      ServiceBooking[]
  reviews              Review[]
  cartItems            CartItem[]
  complaints           Complaint[]
  assignedServices     ServiceBooking[]     @relation("AssignedProvider")
  savedAddresses       SavedAddress[]
  pushSubscriptions    PushSubscription[]
  serviceSubscriptions ServiceSubscription[]
}

// ==========================================
// PROPERTY MARKETPLACE ENTITIES
// ==========================================

model Property {
  id                 String   @id @default(uuid())
  providerId         String
  provider           User     @relation("ProviderProperties", fields: [providerId], references: [id], onDelete: Cascade)
  providerName       String
  providerPhone      String
  providerAvatar     String?
  providerIsVerified Boolean  @default(true)

  title              String
  description        String
  propertyType       String   // Apartment, Villa, Studio, Condominium, Townhouse
  transactionType    String   @default("RENT") // RENT, SALE
  price              Float
  rentPrice          Float?
  salePrice          Float?
  rentalPeriod       String   @default("Monthly")
  rooms              Int
  bathrooms          Int

  city               String
  area               String
  neighborhood       String
  addressDetails     String?

  images             String   @default("[]") // JSON string array
  amenities          String   @default("[]") // JSON string array

  availability       Boolean  @default(true)
  isVerified         Boolean  @default(true)
  listingStatus      String   @default("pending") // pending, active, rented, sold, rejected

  viewsCount         Int      @default(0)
  inquiriesCount     Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  favorites          Favorite[]
  inquiries          Inquiry[]
  reports            Report[]
  propertyDocuments  PropertyDocument[]
  rentalRequests     RentalRequest[]
  saleRequests       SaleRequest[]
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Inquiry {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyTitle String
  propertyImage String
  seekerId      String
  seeker        User     @relation("SeekerInquiries", fields: [seekerId], references: [id], onDelete: Cascade)
  seekerName    String
  seekerPhone   String
  providerId    String
  message       String
  messages      String   @default("[]") // JSON string array of chat messages
  status        String   @default("new_inquiry") // new_inquiry, responded, viewing_arranged, closed
  response      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // SYSTEM, INQUIRY, PROPERTY, RESPONSE, SUBSCRIPTION
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Report {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  createdAt  DateTime @default(now())
}

// ==========================================
// VERIFICATION & FINANCIAL ENTITIES
// ==========================================

model IdentityDocument {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idType       String   // NATIONAL_ID, PASSPORT, DRIVERS_LICENSE
  idNumber     String
  documentUrl  String
  selfieUrl    String?
  status       String   @default("PENDING") // PENDING, UNDER_REVIEW, VERIFIED, REJECTED
  aiRiskScore  Float?
  aiNotes      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PropertyDocument {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId     String
  docType     String   // TITLE_DEED, SITE_PLAN, LEASE_LICENSE
  docUrl      String
  status      String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  aiRiskScore Float?
  aiNotes     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubscriptionPlan {
  id           String         @id @default(uuid())
  name         String         @unique // Basic, Professional, Business
  priceETB     Float
  durationDays Int            @default(30)
  maxListings  Int            @default(5)
  features     String         @default("[]") // JSON string array
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  status     String           @default("PENDING") // PENDING, ACTIVE, EXPIRED, CANCELLED
  startDate  DateTime         @default(now())
  endDate    DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  payments   Payment[]
}

model Payment {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountETB        Float
  currency         String          @default("ETB")
  paymentMethod    String          @default("CHAPA_SIMULATION") // CHAPA_SIMULATION, CHAPA_REAL, CBE_BIRR
  reference        String          @unique
  status           String          @default("PENDING") // PENDING, SUCCESS, FAILED
  chapaTxRef       String?         @unique
  chapaCheckoutUrl String?
  orderId          String?         @unique
  order            Order?          @relation(fields: [orderId], references: [id])
  serviceBookingId String?         @unique
  serviceBooking   ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model RentalRequest {
  id                String    @id @default(uuid())
  propertyId        String
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renterId          String
  renter            User      @relation("RenterRequests", fields: [renterId], references: [id], onDelete: Cascade)
  ownerId           String
  status            String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, ACTIVE, COMPLETED, TERMINATED
  proposedStartDate DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SaleRequest {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User     @relation("BuyerRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  ownerId         String
  offeredPriceETB Float
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, UNDER_REVIEW, LEGAL_PROCESS, COMPLETED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ==========================================
// CMS PLATFORM CONFIGURATION MODEL
// ==========================================

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON string payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// CONSOLIDATED WEB VENDOR & SERVICE ENTITIES
// ==========================================

model Vendor {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  description      String?
  logo             String?
  status           String   @default("PENDING")
  subscriptionPlan String   @default("basic")
  commissionRate   Float    @default(10)
  revenue          Float    @default(0)
  onboardingStep   Int      @default(0)
  businessCategory String?
  taxId            String?
  bankAccount      String?
  contactEmail     String?
  offersServices   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products        Product[]
  orders          Order[]
  reviews         Review[]
  messages        VendorMessage[]
  providers       VendorProvider[]
  serviceBookings ServiceBooking[] @relation("VendorBookings")
}

model Product {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  category    String
  image       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  vendorId        String?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])
  status          String   @default("PENDING")
  subtotal        Float
  commission      Float    @default(0)
  total           Float
  notes           String?
  shippingAddress String?
  shippingCity    String?
  shippingLat     Float?
  shippingLng     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items    OrderItem[]
  payment  Payment?
  tracking TrackingEvent[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  name      String
}

model ServiceBooking {
  id                   String   @id @default(uuid())
  bookingNumber        String   @unique
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  vendorId             String?
  vendor               Vendor?  @relation("VendorBookings", fields: [vendorId], references: [id])
  type                 String
  status               String   @default("PENDING")
  scheduledAt          DateTime
  address              String
  city                 String   @default("Addis Ababa")
  propertySize         String?
  rooms                Int?
  distanceKm           Float?
  estimatedPrice       Float
  finalPrice           Float?
  notes                String?
  providerId           String?
  provider             User?    @relation("AssignedProvider", fields: [providerId], references: [id])
  packageName          String?
  packageId            String?
  package              ServicePackage? @relation(fields: [packageId], references: [id])
  vendorProviderId     String?
  assignedProviderName String?
  subscriptionId       String?
  subscription         ServiceSubscription? @relation(fields: [subscriptionId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lat Float?
  lng Float?

  payment  Payment?
  review   Review?
  tracking TrackingEvent[]
}

model ServicePackage {
  id              String   @id @default(uuid())
  type            String
  slug            String   @unique
  name            String
  description     String?
  basePrice       Float
  features        String
  isSubscription  Boolean  @default(false)
  billingCycle    String?
  discountPercent Float    @default(0)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  bookings      ServiceBooking[]
  subscriptions ServiceSubscription[]
}

model ServiceSubscription {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId     String
  package       ServicePackage @relation(fields: [packageId], references: [id])
  type          String
  status        String   @default("ACTIVE")
  price         Float
  address       String
  city          String   @default("Addis Ababa")
  nextServiceAt DateTime?
  startedAt     DateTime @default(now())
  endsAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings ServiceBooking[]
}

model Review {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  vendorId         String?
  vendor           Vendor?         @relation(fields: [vendorId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  serviceBookingId String?         @unique
  serviceBooking   ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  rating           Int
  comment          String?
  createdAt        DateTime        @default(now())
}

model Complaint {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  description String
  status      String   @default("OPEN")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  city      String   @default("Addis Ababa")
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TrackingEvent {
  id               String          @id @default(uuid())
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceBookingId String?
  serviceBooking   ServiceBooking? @relation(fields: [serviceBookingId], references: [id], onDelete: Cascade)
  status           String
  message          String
  createdAt        DateTime        @default(now())
}

model VendorMessage {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  senderId    String
  recipientId String?
  orderId     String?
  subject     String
  body        String
  read        Boolean  @default(false)
  direction   String   @default("OUTBOUND")
  createdAt   DateTime @default(now())
}

model VendorProvider {
  id         String   @id @default(uuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  providerId String
  name       String
  phone      String?
  email      String?
  specialty  String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  keys      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

