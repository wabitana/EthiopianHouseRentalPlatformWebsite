// ==========================================
// ETHIOPIAN HOUSE RENTAL & DELALA PLATFORM SCHEMA
// Normalized Phase 1 Production Architecture
// ==========================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUM DEFINITIONS
// ==========================================

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum VisitStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum AgreementStatus {
  PENDING
  OWNER_CONFIRMED
  RENTER_CONFIRMED
  COMPLETED
}

// ==========================================
// 1. USER & IDENTITY ENTITIES
// ==========================================

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String?  @unique
  passwordHash  String

  role          String   @default("seeker") // seeker, provider, admin, agent

  avatarUrl     String?

  isVerified                 Boolean @default(false)

  isEmailVerified            Boolean @default(false)
  emailVerificationCode      String?
  emailVerificationExpires   DateTime?

  isPhoneVerified            Boolean @default(false)
  phoneVerificationCode      String?
  phoneVerificationExpires   DateTime?

  rating         Float   @default(0)
  totalListings  Int     @default(0)
  active         Boolean @default(true)

  address        String?
  city           String? @default("Addis Ababa")
  region         String? @default("Addis Ababa")

  // Regional Sub-Admin Territory Scope
  assignedArea   String?   @default("Addis Ababa")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  properties        Property[]          @relation("ProviderProperties")
  subscriptions     Subscription[]
  payments          Payment[]
  rentalRequests    RentalRequest[]     @relation("RenterRequests")
  saleRequests      SaleRequest[]       @relation("BuyerRequests")
  notifications     Notification[]
  reviews           Review[]
  favorites         Favorite[]
  reports           Report[]
  complaints        Complaint[]
  refreshTokens     RefreshToken[]

  verification      IdentityDocument?

  tasks             Task[]             @relation("AgentTasks")
  assistedTenants   AssistedTenant[]   @relation("AgentAssistedTenants")
  assistedBookings  AssistedBooking[]  @relation("AgentAssistedBookings")
  leaseAgreements   LeaseAgreement[]   @relation("AgentLeases")
  featurePhoneSms   FeaturePhoneSms[]  @relation("AgentSms")
  inquiriesSent     Inquiry[]          @relation("SeekerInquiries")
}

// ==========================================
// 2. PROPERTY MARKETPLACE ENTITIES
// ==========================================

model Property {
  id                 String   @id @default(uuid())

  providerId         String
  provider           User     @relation("ProviderProperties", fields: [providerId], references: [id], onDelete: Cascade)

  providerName       String
  providerPhone      String
  providerAvatar     String?
  providerIsVerified Boolean  @default(false)

  title              String
  description        String
  propertyType       String

  transactionType    String   @default("RENT")

  price              Float
  rentPrice          Float?
  salePrice          Float?

  rentalPeriod       String   @default("Monthly")

  rooms              Int
  bathrooms          Int

  city               String   @default("Addis Ababa")
  area               String
  neighborhood       String
  addressDetails     String?

  latitude           Float?
  longitude          Float?

  images             String   @default("[]")
  amenities          String   @default("[]")

  availability       Boolean  @default(true)
  isVerified         Boolean  @default(false)
  listingStatus      String   @default("pending") // pending, active, rented, sold, rejected

  viewsCount         Int      @default(0)
  inquiriesCount     Int      @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  houseImages        HouseImage[]
  documents          PropertyDocument[]
  rentalRequests     RentalRequest[]
  saleRequests       SaleRequest[]
  reviews            Review[]
  favorites          Favorite[]
  reports            Report[]
  visits             HouseVisit[]
  inquiries          Inquiry[]
  assistedBookings   AssistedBooking[]
}

model HouseImage {
  id          String   @id @default(uuid())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  imageUrl    String

  createdAt   DateTime @default(now())
}

model IdentityDocument {
  id           String             @id @default(uuid())

  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  idType       String
  idNumber     String

  documentUrl  String
  selfieUrl    String?

  status       VerificationStatus @default(PENDING)

  aiRiskScore  Float?
  aiNotes      String?

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model PropertyDocument {
  id          String             @id @default(uuid())

  propertyId  String
  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ownerId     String

  docType     String
  docUrl      String

  status      VerificationStatus @default(PENDING)

  aiRiskScore Float?
  aiNotes     String?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// ==========================================
// 3. SUBSCRIPTION & FINANCIAL ENTITIES
// ==========================================

model SubscriptionPlan {
  id            String         @id @default(uuid())

  name          String         @unique
  priceETB      Float

  durationDays  Int            @default(30)
  maxListings   Int            @default(5)

  features      String         @default("[]")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id         String             @id @default(uuid())

  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId     String
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])

  status     SubscriptionStatus @default(PENDING)

  startDate  DateTime           @default(now())
  endDate    DateTime

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  payments   Payment[]
}

model Payment {
  id               String        @id @default(uuid())

  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])

  amountETB        Float

  currency         String        @default("ETB")
  paymentMethod    String
  reference        String        @unique

  status           PaymentStatus @default(PENDING)

  chapaTxRef       String?       @unique
  chapaCheckoutUrl String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// ==========================================
// 4. RENTAL & SALE WORKFLOW ENTITIES
// ==========================================

model RentalRequest {
  id                String        @id @default(uuid())

  propertyId        String
  property          Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  renterId          String
  renter            User          @relation("RenterRequests", fields: [renterId], references: [id], onDelete: Cascade)

  ownerId           String

  status            String        @default("PENDING")

  proposedStartDate DateTime?
  notes             String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  visit             HouseVisit?
  agreement         RentalAgreement?
}

model SaleRequest {
  id              String        @id @default(uuid())

  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  buyerId         String
  buyer           User          @relation("BuyerRequests", fields: [buyerId], references: [id], onDelete: Cascade)

  ownerId         String

  offeredPriceETB Float

  status          String        @default("PENDING")

  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model HouseVisit {
  id          String        @id @default(uuid())

  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  requestId   String        @unique
  request     RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  renterId    String
  ownerId     String

  visitDate   DateTime

  status      VisitStatus   @default(PENDING)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model RentalAgreement {
  id              String          @id @default(uuid())

  requestId       String          @unique
  request         RentalRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  renterId        String
  ownerId         String

  rentAmount      Float

  startDate       DateTime
  endDate         DateTime

  ownerConfirmed  Boolean         @default(false)
  renterConfirmed Boolean         @default(false)

  status          AgreementStatus @default(PENDING)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Inquiry {
  id            String   @id @default(uuid())

  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  seekerId      String
  seeker        User     @relation("SeekerInquiries", fields: [seekerId], references: [id], onDelete: Cascade)

  providerId    String?
  seekerName    String?
  seekerPhone   String?
  propertyTitle String?
  propertyImage String?

  message       String
  messages      String   @default("[]")
  response      String?
  phone         String?
  status        String   @default("PENDING")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==========================================
// 5. USER FEEDBACK, NOTIFICATIONS & AGENT MODULES
// ==========================================

model Review {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rating      Int
  comment     String?

  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String

  type      String   @default("SYSTEM")
  link      String?

  read      Boolean  @default(false)

  createdAt DateTime @default(now())
}

model Favorite {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Report {
  id         String   @id @default(uuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  reason     String
  details    String?

  createdAt  DateTime @default(now())
}

model Complaint {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject     String
  description String

  status      String   @default("OPEN")
  adminNotes  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id              String   @id @default(uuid())

  title           String
  type            String

  propertyId      String?
  propertyTitle   String?
  providerName    String?

  assignedAgentId String
  assignedAgent   User     @relation("AgentTasks", fields: [assignedAgentId], references: [id], onDelete: Cascade)

  dueDate         DateTime

  priority        String   @default("Medium")
  status          String   @default("Pending")

  description     String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AssistedTenant {
  id                 String            @id @default(uuid())

  fullName           String
  featurePhone       String            @unique

  kebeleIdNumber     String

  region             String
  woreda             String

  preferredHouseType String

  maxBudgetETB       Float

  familySize         Int

  hasSmartphone      Boolean           @default(false)

  status             String            @default("Active Search")

  agentId            String
  agent              User              @relation("AgentAssistedTenants", fields: [agentId], references: [id], onDelete: Cascade)

  assistedBookings   AssistedBooking[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model AssistedBooking {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         AssistedTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId        String
  agent          User           @relation("AgentAssistedBookings", fields: [agentId], references: [id], onDelete: Cascade)

  monthlyRentETB Float
  depositETB     Float          @default(0)
  paymentMethod  String         @default("CASH")
  receiptNumber  String         @unique

  status         String         @default("CONFIRMED")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  leases         LeaseAgreement[]
}

model LeaseAgreement {
  id                 String          @id @default(uuid())
  bookingId          String?
  booking            AssistedBooking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  contractNumber     String?         @unique

  tenantName         String
  tenantKebeleId     String?
  providerName       String?
  providerIdNumber   String?
  landlordName       String          @default("Landlord")
  propertyTitle      String
  location           String?

  monthlyRentETB     Float
  depositETB         Float           @default(0)

  startDate          DateTime
  endDate            DateTime

  kebeleWitnessName  String?
  kebeleWitnessStamp String?

  status             String          @default("ACTIVE")

  agentId            String
  agent              User            @relation("AgentLeases", fields: [agentId], references: [id], onDelete: Cascade)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model FeaturePhoneSms {
  id             String    @id @default(uuid())

  recipientPhone String
  recipientName  String

  messageAmharic String
  messageEnglish String

  otpCode        String?
  expiresAt      DateTime?

  status         String    @default("QUEUED")
  sentTime       DateTime  @default(now())

  agentId        String?
  agent          User?     @relation("AgentSms", fields: [agentId], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
}

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique

  expiresAt DateTime

  revoked   Boolean  @default(false)

  createdAt DateTime @default(now())
}
